# 3) Hands-free voice UI (browser)

Use the **Web Speech API** for speech-to-text + text-to-speech. The UI parses commands like “deposit 0.02 ETH to token 3” or “withdraw 0.01 ETH from token 1”.

```tsx
// web/components/VoicePiggy.tsx
"use client";
import { useEffect, useRef, useState } from "react";
import { useWriteContract } from "wagmi";
import abi from "../PiggyBankNFT.abi.json";

const CONTRACT = process.env.NEXT_PUBLIC_PIGGYBANK_ADDRESS as `0x${string}`;

export default function VoicePiggy() {
  const [listening, setListening] = useState(false);
  const [lastCmd, setLastCmd] = useState("");
  const { writeContractAsync } = useWriteContract();

  const recRef = useRef<SpeechRecognition | null>(null);
  useEffect(() => {
    const SR = (window as any).webkitSpeechRecognition || (window as any).SpeechRecognition;
    if (!SR) return;
    const r = new SR();
    r.continuous = true; r.lang = "en-US";
    r.onresult = async (e: SpeechRecognitionEvent) => {
      const cmd = e.results[e.results.length - 1][0].transcript.trim();
      setLastCmd(cmd);
      await handleCommand(cmd);
    };
    recRef.current = r;
  }, []);

  function speak(text: string) {
    const u = new SpeechSynthesisUtterance(text);
    window.speechSynthesis.speak(u);
  }

  async function handleCommand(cmd: string) {
    // very simple parser; production: use an LLM function-calling endpoint
    const dep = cmd.match(/deposit ([\d.]+) (?:eth|ether) to token (\d+)/i);
    const wdr = cmd.match(/withdraw ([\d.]+) (?:eth|ether) from token (\d+)/i);

    if (dep) {
      const [_, amount, id] = dep;
      speak(`Depositing ${amount} ETH to token ${id}`);
      await writeContractAsync({
        address: CONTRACT,
        abi,
        functionName: "depositETH",
        args: [BigInt(id)],
        value: BigInt(Math.floor(parseFloat(amount) * 1e18))
      });
      speak("Deposit submitted.");
      return;
    }
    if (wdr) {
      const [_, amount, id] = wdr;
      speak(`Requesting withdrawal of ${amount} ETH from token ${id}`);
      // here you can call your *AI agent API* to create a SpendIntent and relay it
      await fetch("/api/withdraw", {
        method: "POST",
        headers: {"content-type":"application/json"},
        body: JSON.stringify({ tokenId: Number(id), amountEth: amount })
      });
      speak("Withdrawal request sent to the AI agent.");
      return;
    }
    speak("Sorry, I didn't understand.");
  }

  return (
    <div style={{ padding: 16, border: "1px solid #333", borderRadius: 12 }}>
      <h3>🎙️ Voice Piggy</h3>
      <button
        onClick={() => { if (!recRef.current) return; listening ? recRef.current.stop() : recRef.current.start(); setListening(!listening); }}
      >
        {listening ? "Stop Listening" : "Start Listening"}
      </button>
      <p>Last command: {lastCmd || "—"}</p>
      <small>Try: “Deposit 0.02 ETH to token 3” or “Withdraw 0.01 ETH from token 1”.</small>
    </div>
  );
}
```

> Hook the `/api/withdraw` route to call your **AI agent**’s `handleSpend()` (from §2) so approvals are automatic.

