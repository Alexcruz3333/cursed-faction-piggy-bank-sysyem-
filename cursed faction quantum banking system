# 2) AI policy agent (hands-off approvals + safety caps)

An off-chain **TypeScript agent** that watches deposits/requests, applies rules, consults an LLM for context (memo, history), and **auto-signs SpendIntents** within limits. It also supports **daily caps**, **recipient whitelists**, and generates **rationales**.

```ts
// ai/agent.ts
import 'dotenv/config';
import { createWalletClient, http, parseEther, Hex, concat, keccak256 } from 'viem';
import { baseSepolia } from 'viem/chains';
import { privateKeyToAccount } from 'viem/accounts';
import OpenAI from 'openai';
import ABI from '../artifacts/contracts/PiggyBankNFTWithPermit.sol/PiggyBankNFTWithPermit.json';

type SpendReq = {
  tokenId: bigint;
  to: `0x${string}`;
  amountWei: bigint;
  asset?: `0x${string}`; // undefined or 0x0 => ETH
  memo?: string;
  deadlineSec?: number;   // default now + 10 minutes
};

const CONTRACT = process.env.CONTRACT as `0x${string}`;
const PK = process.env.AGENT_PK!;
const account = privateKeyToAccount(PK as Hex);
const client = createWalletClient({ account, chain: baseSepolia, transport: http(process.env.RPC!) });

const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });

const DAILY_CAP_WEI = parseEther('0.2');     // configurable
const SINGLE_CAP_WEI = parseEther('0.05');
const WHITELIST = new Set<string>([
  (process.env.TREASURY ?? '').toLowerCase()
]);

let spentToday = 0n;
let day = new Date().toDateString();

function resetIfNeeded() {
  const d = new Date().toDateString();
  if (d !== day) { day = d; spentToday = 0n; }
}

async function llmApprove(req: SpendReq): Promise<{approve: boolean; reason: string; capped?: bigint}> {
  const prompt = `
You are a risk controller for a savings NFT piggy-bank.
Approve only low-risk, whitelisted, goal-related payments.
Reject unknown recipients, vague memos, or amounts above policy.

Request:
- tokenId: ${req.tokenId}
- to: ${req.to}
- amount ETH: ${Number(req.amountWei) / 1e18}
- memo: ${req.memo ?? 'none'}
- whitelisted: ${WHITELIST.has(req.to.toLowerCase())}

Respond as JSON: {"approve":true/false,"reason":"...","capped":"<wei or empty>"}.
  `;
  const out = await openai.chat.completions.create({
    model: "gpt-4o-mini",
    messages: [{ role: "user", content: prompt }],
    temperature: 0
  });
  const txt = out.choices[0]?.message?.content ?? '{"approve":false,"reason":"no response"}';
  try {
    const data = JSON.parse(txt) as {approve:boolean; reason:string; capped?: string};
    return { approve: data.approve, reason: data.reason, capped: data.capped ? BigInt(data.capped) : undefined };
  } catch {
    return { approve: false, reason: "invalid LLM output" };
  }
}

export async function handleSpend(req: SpendReq) {
  resetIfNeeded();
  if (req.amountWei > SINGLE_CAP_WEI) req.amountWei = SINGLE_CAP_WEI;             // hard cap
  if (spentToday + req.amountWei > DAILY_CAP_WEI) return { ok:false, reason:"daily cap" };

  const { approve, reason, capped } = await llmApprove(req);
  if (!approve) return { ok:false, reason };

  const amount = capped && capped < req.amountWei ? capped : req.amountWei;

  // Build EIP-712 struct and sign with owner (this agent holds owner key)
  const deadline = BigInt(Math.floor(Date.now()/1000 + (req.deadlineSec ?? 600)));
  const asset = (req.asset ?? `0x0000000000000000000000000000000000000000`) as `0x${string}`;

  // domain / types are already in the contract; viem `signTypedData`:
  const signature = await client.signTypedData({
    domain: {
      name: "PiggyBank NFT",
      version: "1",
      chainId: baseSepolia.id,
      verifyingContract: CONTRACT
    },
    types: {
      SpendIntent: [
        { name: "tokenId", type: "uint256" },
        { name: "asset",   type: "address" },
        { name: "to",      type: "address" },
        { name: "amount",  type: "uint256" },
        { name: "nonce",   type: "uint256" },
        { name: "deadline",type: "uint256" },
        { name: "isETH",   type: "bool" }
      ]
    },
    primaryType: "SpendIntent",
    message: {
      tokenId: req.tokenId,
      asset,
      to: req.to,
      amount,
      nonce: 0n,          // contract increments internally; set to current read if you mirror it
      deadline,
      isETH: asset === `0x0000000000000000000000000000000000000000`
    }
  });

  // Relay tx calling spendWithPermit:
  const hash = await client.writeContract({
    address: CONTRACT,
    abi: ABI.abi,
    functionName: 'spendWithPermit',
    args: [req.tokenId, asset, req.to, amount, deadline, signature as Hex]
  });

  spentToday += amount;
  return { ok:true, tx: hash, reason };
}
```

> Run as a daemon or server. It keeps you “hands-off”: when a request hits your API (from the game, from the voice UI), the **agent auto-decides & signs** within policy.

