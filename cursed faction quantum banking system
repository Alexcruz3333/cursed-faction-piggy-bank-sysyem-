### 4a) Qiskit: Quantum randomness + allocation suggestion

```python
# ai/quantum/allocator.py
# pip install qiskit==1.0.2 numpy
from qiskit import QuantumCircuit
from qiskit.primitives import Sampler
import numpy as np

def qrng_uint(nbits=16):
    qc = QuantumCircuit(nbits, nbits)
    qc.h(range(nbits))
    qc.measure(range(nbits), range(nbits))
    sampler = Sampler()
    result = sampler.run(qc).result()
    # get the most probable bitstring
    counts = result.quasi_dists[0]
    bitstr = max(counts, key=counts.get)
    return int(bitstr, 2)

def suggest_split(target_eth: float, buckets: list[str]):
    # quantum randomness to seed a Dirichlet -> allocation
    seed = qrng_uint(16)
    rng = np.random.default_rng(seed)
    weights = rng.dirichlet(np.ones(len(buckets)))
    amounts = (weights * target_eth).round(6)
    return dict(zip(buckets, amounts.tolist()))

if __name__ == "__main__":
    plan = suggest_split(0.5, ["personal","guild","events"])
    print(plan)
```

> Use this to propose **transparent, verifiably random** splits. You can publish the seed & backend ID for auditability.

