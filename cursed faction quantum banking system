// web/app/api/withdraw/route.ts
import { NextRequest, NextResponse } from 'next/server';

export async function POST(req: NextRequest) {
  const { tokenId, amountEth, to } = await req.json();
  const body = { tokenId, amountWei: BigInt(Math.floor(parseFloat(amountEth) * 1e18)), to: to ?? process.env.DEFAULT_PAYOUT };
  // forward to your agent (running locally or hosted)
  const r = await fetch(process.env.AGENT_URL + "/spend", {
    method: "POST",
    headers: {"content-type":"application/json"},
    body: JSON.stringify(body)
  });
  const data = await r.json();
  return NextResponse.json(data);
}
