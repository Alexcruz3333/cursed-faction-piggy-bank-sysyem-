# 1) Smart-contract upgrade (minimal, safe)

You already have owner withdrawals + per-token allowances. We’ll add an **EIP-712 permit** so an **AI agent can pre-sign** spend/withdraw actions without exposing keys, and the dApp can submit the signed intent (gas paid by a relayer if you want). If you prefer to keep it ultra-simple, skip this—allowances already work. This is optional.

> 🔒 Design: owner signs a typed “SpendIntent” for a specific `tokenId`, `asset`, `to`, `amount`, `nonce`, `deadline`. Contract verifies signature via ECDSA, checks lock/allowance, executes.

```solidity
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import "./PiggyBankNFT.sol";
import "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
import "@openzeppelin/contracts/utils/cryptography/MessageHashUtils.sol";

contract PiggyBankNFTWithPermit is PiggyBankNFT {
    using ECDSA for bytes32;

    // EIP-712 domain separator data
    bytes32 private immutable _DOMAIN_SEPARATOR;
    uint256 private immutable _CHAIN_ID;

    // keccak256("SpendIntent(uint256 tokenId,address asset,address to,uint256 amount,uint256 nonce,uint256 deadline,bool isETH)")
    bytes32 private constant SPEND_TYPEHASH =
        0x7fa4a0b0d6d1b0d3d0b8d2a7854b6d78e2b0d8f0f0e1b6b6c6d3c6f5b03c2b88;

    mapping(uint256 => uint256) public nonces; // per-token nonce

    constructor(string memory baseURI_) PiggyBankNFT(baseURI_) {
        _CHAIN_ID = block.chainid;
        _DOMAIN_SEPARATOR = _buildDomain();
    }

    function domainSeparator() public view returns (bytes32) {
        return block.chainid == _CHAIN_ID ? _DOMAIN_SEPARATOR : _buildDomain();
    }

    function _buildDomain() private view returns (bytes32) {
        return keccak256(
            abi.encode(
                // keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)")
                0xd87cd6adf7adfca1c0d6b12b0f3fcd65a01773b901f271f5f9c7c5b2b4be3f4c,
                keccak256(bytes("PiggyBank NFT")),
                keccak256(bytes("1")),
                block.chainid,
                address(this)
            )
        );
    }

    function spendWithPermit(
        uint256 tokenId,
        address asset,   // address(0) for ETH; ERC20 otherwise
        address to,
        uint256 amount,
        uint256 deadline,
        bytes calldata sig
    ) external nonReentrant whenNotPaused {
        if (block.timestamp > deadline) revert NotAllowed();
        _existsToken(tokenId);
        _checkUnlocked(tokenId);
        if (amount == 0) revert ZeroAmount();

        uint256 nonce = nonces[tokenId]++;
        bytes32 digest = keccak256(
            abi.encodePacked(
                "\x19\x01",
                domainSeparator(),
                keccak256(abi.encode(SPEND_TYPEHASH, tokenId, asset, to, amount, nonce, deadline, asset == address(0)))
            )
        );

        address signer = ECDSA.recover(digest, sig);
        if (signer != ownerOf(tokenId)) revert NotOwner();

        if (asset == address(0)) {
            if (amount > ethBalance[tokenId]) revert InsufficientBalance();
            ethBalance[tokenId] -= amount;
            (bool ok, ) = to.call{value: amount}("");
            require(ok, "ETH transfer failed");
            emit WithdrawnETH(tokenId, to, amount);
        } else {
            if (amount > erc20Balance[tokenId][asset]) revert InsufficientBalance();
            erc20Balance[tokenId][asset] -= amount;
            IERC20(asset).safeTransfer(to, amount);
            emit WithdrawnERC20(tokenId, asset, to, amount);
        }
    }
}
```

> Keep your original `PiggyBankNFT` if you prefer simplicity. This permit route just enables **gas-sponsored / AI-signed** spends.

